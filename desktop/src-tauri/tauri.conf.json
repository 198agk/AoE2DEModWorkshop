{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AoE2 DE Mod Workshop",
  "version": "1.0.13",
  "identifier": "com.dsh.aoe2modworkshop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "loading",
        "title": "帝国时代 2 决定版 · 模组工坊 · By - RemonBo",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
