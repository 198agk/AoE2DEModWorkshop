{
  "$comment": "How each intent is SAID in Chinese. This is the inverse of aoe2mod/ui/nl.py: the reader turns a sentence into an intent, this table turns a form into the same sentence. It lives in the schema directory, next to intents.json, because it is declaration, not code -- a plugin that ships a sentence shape ships a template here rather than editing the reader. The round-trip test (_probe/test_compose_roundtrip.py) composes every form below and runs it back through the reader; an entry whose sentence the reader does not accept is a broken entry, not a broken test.",
  "version": 1,
  "op_choices": [
    "改成",
    "加",
    "减"
  ],
  "intents": {
    "unit.stat": {
      "label": "改单位属性",
      "forms": [
        {
          "id": "value",
          "label": "把某一项设成某个数",
          "template": "{unit} {stat} 改成 {n}",
          "slots": [
            {
              "name": "unit",
              "kind": "unit",
              "label": "单位",
              "sample": "村民"
            },
            {
              "name": "stat",
              "kind": "stat",
              "label": "属性",
              "required": true,
              "sample": "血量"
            },
            {
              "name": "n",
              "kind": "number",
              "label": "改成",
              "sample": "1000"
            }
          ]
        },
        {
          "id": "delta",
          "label": "加减一点",
          "template": "{unit} {stat} {op}{n}",
          "slots": [
            {
              "name": "unit",
              "kind": "unit",
              "label": "单位",
              "sample": "村民"
            },
            {
              "name": "stat",
              "kind": "stat",
              "label": "属性",
              "required": true,
              "sample": "血量"
            },
            {
              "name": "op",
              "kind": "op",
              "label": "怎么改",
              "required": true,
              "default": "加"
            },
            {
              "name": "n",
              "kind": "number",
              "label": "数值",
              "sample": "10"
            }
          ]
        },
        {
          "id": "class",
          "label": "一整类单位一起改",
          "template": "所有{class}{stat} {op}{n}",
          "slots": [
            {
              "name": "class",
              "kind": "class",
              "label": "哪一类",
              "required": true,
              "sample": "骑兵"
            },
            {
              "name": "stat",
              "kind": "stat",
              "label": "属性",
              "required": true,
              "sample": "血量"
            },
            {
              "name": "op",
              "kind": "op",
              "label": "怎么改",
              "required": true,
              "default": "加"
            },
            {
              "name": "n",
              "kind": "number",
              "label": "数值",
              "sample": "10"
            }
          ]
        }
      ]
    },
